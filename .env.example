# Copy to /mnt/user/appdata/conan-bot/.env and chmod 600. Never commit the real file.
DISCORD_TOKEN=
GUILD_ID=
CHANNEL_ID=
ADMIN_ROLE=Conan Admin

# api = Unraid API key with Docker read+update only; proxy = docker-socket-proxy fallback
CONTROL_MODE=api
UNRAID_URL=https://192.168.10.10/graphql
UNRAID_API_KEY=
PROXY_URL=http://192.168.10.10:2375

SERVER_HOST=192.168.10.10
QUERY_PORT=27015
RCON_PORT=25575
RCON_PASSWORD=

RESTART_TIME=05:00
WARN_MINUTES=15,5,1
KEEP_SNAPSHOTS=14
FPS_ALERT_MIN=10
