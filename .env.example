# conan-bot settings. Copy to <config dir>/.env, fill in, chmod 600. Never commit the real file.

# --- Discord ---
DISCORD_TOKEN=
GUILD_ID=
CHANNEL_ID=
ADMIN_ROLE=Conan Admin

# --- Game server ---
TARGET_CONTAINER=             # name of the Conan Exiles container the bot may start/stop
SERVER_HOST=                  # IP or hostname where the query and RCON ports listen
QUERY_PORT=27015
RCON_PORT=25575
RCON_PASSWORD=

# --- Container control: "api" (Unraid API key) or "proxy" (docker-socket-proxy) ---
CONTROL_MODE=api
UNRAID_URL=                   # https://<unraid-host>/graphql
UNRAID_API_KEY=
PROXY_URL=http://docker-socket-proxy:2375

# --- Schedule and alerts ---
TZ_NAME=America/New_York
RESTART_TIME=05:00
WARN_MINUTES=15,5,1
KEEP_SNAPSHOTS=14
FPS_ALERT_MIN=10

# --- Discord notifications (on/off). Defaults; /conan notify set overrides and saves to /data ---
NOTIFY_PLAYERS=on             # player joined / left
NOTIFY_PERFORMANCE=on         # low tick-rate alerts
NOTIFY_MODS=on                # mod-mismatch login rejections
NOTIFY_CRASHES=on             # unexpected stops and recoveries
NOTIFY_SCHEDULED=on           # daily restart start / finish
NOTIFY_MANUAL=on              # /conan restart start / finish
