<?xml version="1.0"?>
<Container version="2">
  <Name>conan-bot</Name>
  <Repository>ghcr.io/zbrisson/conan-bot:latest</Repository>
  <Registry>https://github.com/ZBrisson/conan-bot/pkgs/container/conan-bot</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Icon>https://raw.githubusercontent.com/ZBrisson/conan-bot/main/icon.png</Icon>
  <Support>https://github.com/ZBrisson/conan-bot</Support>
  <Project>https://github.com/ZBrisson/conan-bot</Project>
  <Overview>Discord status, player list and role-gated restarts for a Conan Exiles dedicated server, plus a scheduled restart with in-game warnings, database snapshots and an event feed. Controls only the one container named in TARGET_CONTAINER.</Overview>
  <Category>GameServers: Tools:</Category>
  <Config Name="Config (.env with secrets)" Target="/config" Default="/mnt/user/appdata/conan-bot" Mode="ro" Description="Holds .env (chmod 600, owner 99:100)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/conan-bot</Config>
  <Config Name="Conan server files" Target="/conan" Default="" Mode="ro" Description="Read-only: the Conan server directory (contains ConanSandbox/)" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="DB snapshots" Target="/backups" Default="/mnt/user/appdata/conan-bot/snapshots" Mode="rw" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/conan-bot/snapshots</Config>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Type="Variable" Display="advanced" Required="false" Mask="false">America/New_York</Config>
</Container>
